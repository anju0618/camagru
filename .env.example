# ---------------------------------------------------------------
# camagru environment variables
#
# Setup:  cp .env.example .env   then edit .env
# .env is git-ignored. NEVER commit real values.
# No spaces around "=", no quotes needed.
# ---------------------------------------------------------------

# --- App ---------------------------------------------------------
# Public URL of the site. Used to build links in emails.
BASE_URL=http://localhost:8000

# REQUIRED. Secret used to sign sessions / CSRF tokens.
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Mail (dev: Mailpit, UI at http://localhost:8025) -------------
# "mailpit" is the service name in docker-compose.yml.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=camagru@localhost
